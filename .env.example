# Backend Django Configuration
# For local development, copy to .env and fill in actual values

# Security
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=0
DJANGO_DEBUG=0

# Allowed hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS configuration (comma-separated URLs)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database - Local Development (PostgreSQL)
# For Render, use DATABASE_URL instead
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sme_scoring
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# Production database (Render PostgreSQL)
# Automatically provided by Render, but can be overridden here
# DATABASE_URL=postgresql://user:password@host:port/database

# Login protection
LOGIN_LOCKOUT_MAX_FAILURES=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# Logging
DJANGO_LOG_LEVEL=WARNING

# Security settings for production
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:5173

# API Port for local development
APP_PORT=8000
